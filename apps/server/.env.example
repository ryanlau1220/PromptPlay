# Enable only after provider funding and permission for this gateway are confirmed.
PROMPTPLAY_LIVE_INFERENCE=false
INFERENCE_BASE_URL=https://cloud-api.near.ai/v1
INFERENCE_MODEL=zai-org/GLM-5.1-FP8
INFERENCE_API_KEY=
INFERENCE_PROVIDER_NAME=OpenAI-compatible
# Enable only after testing these capabilities with the selected provider and model.
INFERENCE_SUPPORTS_STREAMING=false
INFERENCE_SUPPORTS_TOOL_CALLS=false
INFERENCE_SUPPORTS_IMAGES=false
APP_ORIGIN=http://localhost:3000
NEAR_RPC_URL=https://test.rpc.fastnear.com
DATABASE_PATH=promptplay.sqlite
INFERENCE_CAP_MICROUNITS=1000000
PORT=3001
# Set these to true only after the provider grants permission and funds are available.
PROMPTPLAY_PROVIDER_AUTHORIZED=false
PROMPTPLAY_PROVIDER_FUNDED=false
# Integer USD micros per 1,000,000 model tokens, or virtual rates for owner-funded inference.
INPUT_MICROS_PER_MILLION=
OUTPUT_MICROS_PER_MILLION=
# Maximum funded cost of one gateway unit, or the virtual allowance denominator.
MICROS_PER_UNIT=
MAX_CONTEXT_TOKENS=
MAX_OUTPUT_TOKENS=
# Dedicated pre-funded faucet account only; never use a player wallet key.
PROMPTPLAY_FAUCET_ENABLED=false
FAUCET_KEY_PATH=

# Comma-separated Testnet wallets; * enables every authenticated Testnet wallet.
REDEMPTION_ALLOWLIST=

# Escrow account, immutable code hash and restricted approve-only function-call key.
ESCROW_ACCOUNT=
ESCROW_OWNER=
ESCROW_CODE_HASH=
ESCROW_KEY_PATH=

# Web Push VAPID credentials; private key stays on the server.
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=
